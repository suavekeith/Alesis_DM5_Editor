{
  "name": "dm5-editor",
  "productName": "DM5 Editor",
  "version": "1.0.0",
  "description": "Alesis DM5 MIDI Drum Module Editor",
  "main": "main.js",
  "scripts": {
    "build:webui": "plugin/scripts/build-webui.sh",
    "start": "npm run build:webui && electron .",
    "dist": "npm run build:webui && electron-builder --mac",
    "dist-x64": "npm run build:webui && electron-builder --mac --x64",
    "dist-arm64": "npm run build:webui && electron-builder --mac --arm64",
    "dist-universal": "npm run build:webui && electron-builder --mac --x64 --arm64"
  },
  "build": {
    "appId": "com.dm5editor.app",
    "productName": "DM5 Editor",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "plugin/WebUI/**/*"
    ]
  },
  "devDependencies": {
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "electron": "^41.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
